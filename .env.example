# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for metadata and social cards
NEXT_PUBLIC_SITE_URL=https://descasio.io

# Supabase (server-only; used by the contact form and AI readiness assessment)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORDPRESS_API_URL=https://descasio.io/wp-json/wp/v2

# Set to "true" only on the live descasio.io deployment. Any other value keeps search engines out.
ALLOW_INDEXING=false
